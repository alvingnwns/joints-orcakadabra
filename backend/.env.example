# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose.yml (added in CP2)
DATABASE_URL=postgresql+psycopg://orca:orca@localhost:5432/orca

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# LLM provider (used from CP12). Keep the key here only, never in the frontend.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-14b
