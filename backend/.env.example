# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose.yml (added in CP2)
# Production (Supabase): use the Session pooler connection string with SSL, e.g.
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://orca:orca@127.0.0.1:5432/orca

# Comma-separated browser origins allowed to call this API
# Production: the Vercel URL, e.g. https://orca.vercel.app (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# LLM provider (OpenRouter). Keep the key here only, never in the frontend.
# Free endpoints must be allowed in OpenRouter Settings -> Privacy.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Brain-dump parsing: needs strict JSON-schema support.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Schedule chat (CP14): plain text answers.
LLM_CHAT_MODEL=google/gemma-4-31b-it:free
LLM_TIMEOUT_SECONDS=20
